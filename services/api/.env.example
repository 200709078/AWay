DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/away?schema=public"

JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m

JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=30d

# Production'da web cookie oturumu için açık origin listesi zorunludur.
# CORS_ORIGIN=https://admin.example.com
NODE_ENV=development

# Yalnız NODE_ENV=development iken sabit OTP kullanılır. Kaldırılırsa
# geliştirmede rastgele OTP üretimine dönülür; production'da her zaman yok sayılır.
DEV_OTP_CODE=111111

PORT=3000
