generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum SchoolStatus {
  ACTIVE
  INACTIVE
}

enum MembershipRole {
  ADMIN
  TEACHER
  PARENT
  STUDENT
}

enum AttendanceStatus {
  SUBMITTED
  LOCKED
}

enum AttendanceStudentStatus {
  PRESENT
  ABSENT
}

enum AttendanceEditRequestStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  COMPLETED
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model User {
  id              String    @id @default(cuid())
  phone           String    @unique
  firstName       String
  lastName        String
  phoneVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  memberships     SchoolMembership[]
  studentProfiles Student[]
  parentProfiles  Parent[]
  otpCodes        OtpCode[]
  refreshSessions RefreshSession[]
  auditLogs       AuditLog[]         @relation("AuditActor")

  @@index([lastName, firstName])
}

model School {
  id                             String       @id @default(cuid())
  code                           String       @unique
  name                           String
  status                         SchoolStatus @default(ACTIVE)
  attendanceFinalizedThroughDate DateTime?    @db.Date
  createdAt                      DateTime     @default(now())
  updatedAt                      DateTime     @updatedAt
  deletedAt                      DateTime?

  memberships      SchoolMembership[]
  adminAssignments SchoolAdminAssignment[]
  classes          Class[]
  lessonPeriods    SchoolLessonPeriod[]
  attendances      Attendance[]
  students         Student[]
  parents          Parent[]
  auditLogs        AuditLog[]

  @@index([status])
}

model SchoolMembership {
  id        String         @id @default(cuid())
  schoolId  String
  userId    String
  role      MembershipRole
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  deletedAt DateTime?

  school                   School                  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user                     User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  adminAssignments         SchoolAdminAssignment[]
  submittedAttendances     Attendance[]            @relation("AttendanceSubmittedBy")
  reviewLockedAttendances  Attendance[]            @relation("AttendanceReviewLockedBy")
  exportedAttendances      Attendance[]            @relation("AttendanceExportedBy")
  requestedAttendanceEdits AttendanceEditRequest[] @relation("AttendanceEditRequestedBy")
  reviewedAttendanceEdits  AttendanceEditRequest[] @relation("AttendanceEditReviewedBy")
  auditLogs                AuditLog[]

  @@unique([schoolId, userId, role])
  @@index([schoolId, role])
  @@index([userId])
}

model SchoolAdminAssignment {
  id           String    @id @default(cuid())
  schoolId     String
  membershipId String
  startedAt    DateTime  @default(now())
  endedAt      DateTime?
  createdAt    DateTime  @default(now())

  school     School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  membership SchoolMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([schoolId, startedAt])
  @@index([membershipId])
}

model Class {
  id        String    @id @default(cuid())
  schoolId  String
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  school      School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  students    Student[]
  attendances Attendance[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

model Student {
  id        String    @id @default(cuid())
  schoolId  String
  classId   String
  userId    String?
  number    Int
  firstName String
  lastName  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  class               Class                       @relation(fields: [classId], references: [id], onDelete: Restrict)
  user                User?                       @relation(fields: [userId], references: [id], onDelete: SetNull)
  school              School                      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  parents             ParentStudent[]
  attendanceSnapshots AttendanceStudentSnapshot[]

  @@unique([schoolId, userId])
  @@unique([schoolId, number])
  @@index([schoolId, classId])
  @@index([classId, number])
  @@index([schoolId, lastName, firstName])
}

model Parent {
  id        String    @id @default(cuid())
  schoolId  String
  userId    String?
  firstName String
  lastName  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  school   School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user     User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  students ParentStudent[]

  @@unique([schoolId, userId])
  @@index([schoolId])
  @@index([schoolId, lastName, firstName])
}

model ParentStudent {
  parentId  String
  studentId String
  createdAt DateTime @default(now())

  parent  Parent  @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([parentId, studentId])
  @@index([studentId])
}

model SchoolLessonPeriod {
  id           String    @id @default(cuid())
  schoolId     String
  dayOfWeek    DayOfWeek
  lessonNumber Int
  startMinute  Int
  endMinute    Int
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  // The raw `lesson_period_constraints` migration additionally enforces the
  // minute range and non-overlapping [startMinute, endMinute) intervals.
  @@unique([schoolId, dayOfWeek, lessonNumber])
  @@index([schoolId, dayOfWeek])
}

model Attendance {
  id                         String           @id @default(cuid())
  schoolId                   String
  classId                    String
  classNameSnapshot          String
  lessonDate                 DateTime         @db.Date
  lessonNumber               Int
  lessonStartMinuteSnapshot  Int?
  lessonEndMinuteSnapshot    Int?
  submittedByMembershipId    String
  status                     AttendanceStatus @default(SUBMITTED)
  revision                   Int              @default(1)
  submittedAt                DateTime         @default(now())
  reviewLockedAt             DateTime?
  reviewLockedByMembershipId String?
  exportedAt                 DateTime?
  exportedByMembershipId     String?
  exportedRevision           Int?
  createdAt                  DateTime         @default(now())
  updatedAt                  DateTime         @updatedAt

  school                   School                      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class                    Class                       @relation(fields: [classId], references: [id], onDelete: Cascade)
  submittedByMembership    SchoolMembership            @relation("AttendanceSubmittedBy", fields: [submittedByMembershipId], references: [id], onDelete: Restrict)
  reviewLockedByMembership SchoolMembership?           @relation("AttendanceReviewLockedBy", fields: [reviewLockedByMembershipId], references: [id], onDelete: SetNull)
  exportedByMembership     SchoolMembership?           @relation("AttendanceExportedBy", fields: [exportedByMembershipId], references: [id], onDelete: SetNull)
  studentSnapshots         AttendanceStudentSnapshot[]
  editRequests             AttendanceEditRequest[]

  @@unique([schoolId, classId, lessonDate, lessonNumber])
  @@index([schoolId, lessonDate])
  @@index([classId, lessonDate])
  @@index([submittedByMembershipId])
  @@index([reviewLockedByMembershipId])
  @@index([exportedByMembershipId])
}

model AttendanceStudentSnapshot {
  attendanceId  String
  studentId     String
  studentNumber Int
  firstName     String
  lastName      String
  status        AttendanceStudentStatus
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  attendance Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@id([attendanceId, studentId])
  @@index([studentId])
  @@index([attendanceId, status])
}

model AttendanceEditRequest {
  id                      String                      @id @default(cuid())
  attendanceId            String
  requestedByMembershipId String
  reason                  String
  status                  AttendanceEditRequestStatus @default(PENDING)
  requestedAt             DateTime                    @default(now())
  reviewedByMembershipId  String?
  reviewedAt              DateTime?
  reviewNote              String?
  editGrantedAt           DateTime?
  editExpiresAt           DateTime?
  completedAt             DateTime?
  invalidatedAt           DateTime?
  createdAt               DateTime                    @default(now())
  updatedAt               DateTime                    @updatedAt

  attendance            Attendance        @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  requestedByMembership SchoolMembership  @relation("AttendanceEditRequestedBy", fields: [requestedByMembershipId], references: [id], onDelete: Restrict)
  reviewedByMembership  SchoolMembership? @relation("AttendanceEditReviewedBy", fields: [reviewedByMembershipId], references: [id], onDelete: SetNull)

  @@index([attendanceId, status])
  @@index([requestedByMembershipId, status])
  @@index([reviewedByMembershipId])
  // A raw migration ensures at most one PENDING or APPROVED request per attendance.
}

model OtpCode {
  id         String    @id @default(cuid())
  userId     String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model RefreshSession {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model AuditLog {
  id                String   @id @default(cuid())
  schoolId          String?
  actorUserId       String?
  actorMembershipId String?
  action            String
  entityType        String
  entityId          String?
  metadata          Json?
  createdAt         DateTime @default(now())

  school          School?           @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  actor           User?             @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  actorMembership SchoolMembership? @relation(fields: [actorMembershipId], references: [id], onDelete: SetNull)

  @@index([schoolId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([actorMembershipId, createdAt])
  @@index([entityType, entityId])
  @@index([createdAt])
}
